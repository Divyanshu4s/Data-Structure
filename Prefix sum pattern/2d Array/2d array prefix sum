//Leetcode->3212
https://leetcode.com/problems/count-submatrices-with-equal-frequency-of-x-and-y/?envType=daily-question&envId=2026-03-24
class Solution {
    public int numberOfSubmatrices(char[][] grid) {
        int n = grid.length;        // number of rows
        int m = grid[0].length;     // number of columns
        int ans = 0;                // final answer (count of valid submatrices)

        // prefix sum arrays for counting X and Y
        int[][] x = new int[n][m];
        int[][] y = new int[n][m];

        // STEP 1: Build prefix sum for X and Y
        for(int i = 0; i < n; i++){
            for(int j = 0; j < m; j++){

                // Count for 'X'
                int a = (grid[i][j] == 'X') ? 1 : 0;

                int up = 0, left = 0, diag = 0;

                // values from previous computed cells
                if(i > 0) up = x[i-1][j];          // above
                if(j > 0) left = x[i][j-1];        // left
                if(i > 0 && j > 0) diag = x[i-1][j-1]; // diagonal

                // prefix sum formula
                x[i][j] = a + up + left - diag;


                // Count for 'Y'
                int b = (grid[i][j] == 'Y') ? 1 : 0;

                // reuse up, left, diag variables
                if(i > 0) up = y[i-1][j];
                if(j > 0) left = y[i][j-1];
                if(i > 0 && j > 0) diag = y[i-1][j-1];

                // prefix sum for Y
                y[i][j] = b + up + left - diag;
            }
        }

        // STEP 2: Count valid submatrices ending at (i, j)
        for(int i = 0; i < n; i++){
            for(int j = 0; j < m; j++){

                int a = x[i][j];   // number of X from (0,0) to (i,j)
                int b = y[i][j];   // number of Y from (0,0) to (i,j)

                // condition: equal number of X and Y and not zero
                if(a == b && a != 0) ans++;
            }
        }

        return ans;
    }
}
